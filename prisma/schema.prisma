generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PracticeLocation {
  Rwandan
  Non_Rwandan
}

enum EntityType {
  Individual
  Firm
}

enum ApplicationStatus {
  Draft
  Pending
  Under_Review
  Pending_Approval
  Correction_Required @map("Correction Required")
  Approved
  Rejected
}

enum MemberClass {
  Student
  Graduate
  Associate
  Technologist
  Professional
  Fellow
  Life_Member
  Honorary_Member
  Visiting_Member
  Firm_Local_Small
  Firm_Local_Medium
  Firm_Local_Large
  Firm_Foreign_Small
  Firm_Foreign_Medium
  Firm_Foreign_Large
}

enum CompetencyLevel {
  Level_0
  Level_1
  Level_2
  Level_3
  Level_4
  Level_5
  Not_Applicable
  Equivalent
  Organization
}

enum SystemRole {
  Admin
  Admin_Assistant
  Head_Reviewer
  Reviewer
  Approver
  Teacher
  Mentor
  Standard
  Student
}

enum ApcStatus {
  Requested
  Scheduled
  Attended
  Passed
  Failed
  No_Show   @map("No Show")
}

enum TransactionType {
  Processing_Fee
  First_Year_Fee
  Annual_Renewal
  Stamp_Fee
  APC_Fee
}

enum PaymentMethod {
  MTN_Momo
  Bank_Transfer
  Card_Payment
  Manual_Cash
}

enum TransactionStatus {
  Unpaid
  Pending_Verification
  Paid
  Failed
  Refunded
}

model MembershipCategory {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  location          PracticeLocation
  entityType        EntityType       @map("entity_type")
  categoryName      String           @unique @map("category_name") @db.VarChar(100)
  categoryCode      String           @map("category_code") @db.VarChar(10)
  processingFee     Decimal          @map("processing_fee") @db.Decimal(12, 2)
  currency          String?          @default("RWF") @db.VarChar(3)
  firstYearFee      Decimal          @map("first_year_fee") @db.Decimal(12, 2)
  annualRenewalFee  Decimal          @map("annual_renewal_fee") @db.Decimal(12, 2)
  stampFee          Decimal?         @default(0.00) @map("stamp_fee") @db.Decimal(12, 2)
  supportedHonors   Json             @default("[]") @map("supported_honors")
  requiredDocuments Json             @default("[]") @map("required_documents")
  optionalDocuments Json             @default("[]") @map("optional_documents")
  competencyLevel   CompetencyLevel? @map("competency_level")

  applications Application[]
  pendingUpgradeApplications Application[] @relation("PendingUpgradeCategory")

  @@map("membership_categories")
}

model Member {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String       @unique @db.VarChar(255)
  passwordHash           String       @map("password_hash") @db.VarChar(255)
  fullName               String       @map("full_name") @db.VarChar(255)
  phoneNumber            String?      @map("phone_number") @db.VarChar(50)
  dateOfBirth            DateTime?    @map("date_of_birth") @db.Date
  gender                 String?      @db.VarChar(20)
  nationality            String?      @db.VarChar(100)
  nationalIdOrPassport   String?      @map("national_id_or_passport") @db.VarChar(100)
  residencyAddress       Json?        @map("residency_address")
  workAddress            Json?        @map("work_address")
  yearsInProfession      Int?         @default(0) @map("years_in_profession")
  countryOfOrigin        String?      @map("country_of_origin") @db.VarChar(100)
  membershipId           String?      @unique @map("membership_id") @db.VarChar(100)
  membershipClass        MemberClass? @map("membership_class")
  systemRole             SystemRole?  @default(Standard) @map("system_role")
  isFellow               Boolean?     @default(false) @map("is_fellow")
  isHonorary             Boolean?     @default(false) @map("is_honorary")
  honors                 Json?        @default("[]") @map("honors")
  trainingTrackingNumber String?      @unique @map("training_tracking_number") @db.VarChar(100)
  isEmailVerified        Boolean?     @default(false) @map("is_email_verified")
  isLocked               Boolean?     @default(false) @map("is_locked")
  lockedUntil            DateTime?    @map("locked_until") @db.Timestamptz
  otpCode                String?      @map("otp_code") @db.VarChar(6)
  otpExpiresAt           DateTime?    @map("otp_expires_at") @db.Timestamptz
  resetPasswordOtp       String?      @map("reset_password_otp") @db.VarChar(6)
  resetPasswordExpires   DateTime?    @map("reset_password_expires") @db.Timestamptz
  membershipExpiresAt    DateTime?    @map("membership_expires_at") @db.Timestamptz
  profilePhotoUrl        String?      @map("profile_photo_url")
  createdAt              DateTime?    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime?    @default(now()) @map("updated_at") @db.Timestamptz

  applications          Application[]
  apcAssessments        ApcAssessment[]
  financialTransactions FinancialTransaction[]
  auditLogs             AuditLog[]
  reviewedApplications  Application[]          @relation("ReviewerAssignments")
  supportTickets        SupportTicket[]
  ticketReplies         TicketReply[]
  applicationReviews    ApplicationReview[]
  mentorshipReviews     MentorshipReview[]
  educationRecords      EducationRecord[]
  employmentRecords     EmploymentRecord[]
  profileEditRequests   ProfileEditRequest[]

  @@map("members")
}

// A member-submitted request to change locked/compliance profile fields
// (name, addresses, photo) or add new education/employment history after
// their original application has already been approved. Nothing is applied
// to the Member record until an Admin/Admin Assistant approves it.
model ProfileEditRequest {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId                  String    @map("member_id") @db.Uuid
  status                    String    @default("Pending") @db.VarChar(20)
  proposedFullName          String?   @map("proposed_full_name") @db.VarChar(255)
  proposedResidencyAddress  Json?     @map("proposed_residency_address")
  proposedWorkAddress       Json?     @map("proposed_work_address")
  proposedProfilePhotoUrl   String?   @map("proposed_profile_photo_url")
  proposedEducation         Json?     @map("proposed_education")
  proposedEmployment        Json?     @map("proposed_employment")
  memberNotes               String?   @map("member_notes") @db.Text
  reviewNotes                String?  @map("review_notes") @db.Text
  reviewedByEmail           String?   @map("reviewed_by_email") @db.VarChar(255)
  reviewedAt                DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt                 DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("profile_edit_requests")
}

model Application {
  id                            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId                      String             @unique @map("member_id") @db.Uuid
  practiceLocation              PracticeLocation   @map("practice_location")
  entityType                    EntityType         @map("entity_type")
  categoryId                    String             @map("category_id") @db.Uuid
  firmName                      String?            @map("firm_name") @db.VarChar(255)
  firmAddress                   String?            @map("firm_address") @db.VarChar(255)
  firmContactRegistrationNumber String?            @map("firm_contact_registration_number") @db.VarChar(100)
  firmContactResidence          String?            @map("firm_contact_residence") @db.VarChar(255)
  firmMainBusinessActivity      String?            @map("firm_main_business_activity") @db.VarChar(255)
  firmCountryOfIncorporation    String?            @map("firm_country_of_incorporation") @db.VarChar(100)
  firmPrincipalPlaceOfBusiness  String?            @map("firm_principal_place_of_business") @db.VarChar(255)
  agreedToMentorshipIntent      Boolean?           @default(false) @map("agreed_to_mentorship_intent")
  agreedToDeclarations          Boolean?           @default(false) @map("agreed_to_declarations")
  hasNoEmployment               Boolean?           @default(false) @map("has_no_employment")
  competenceSummary             Json?              @map("competence_summary")
  status                        ApplicationStatus? @default(Draft)
  assignedReviewerId            String?            @map("assigned_reviewer_id") @db.Uuid
  submittedAt                   DateTime?          @map("submitted_at") @db.Timestamptz
  approvedAt                    DateTime?          @map("approved_at") @db.Timestamptz
  currentStep                   Int?               @default(0) @map("current_step")
  createdAt                     DateTime?          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime?          @default(now()) @map("updated_at") @db.Timestamptz

  // Set when an APC pass or Associate award has been decided but is held pending
  // the member paying the new category's first-year fee. Applied to the Member
  // (and cleared here) once that FinancialTransaction is marked Cleared.
  pendingUpgradeClass           MemberClass?       @map("pending_upgrade_class")
  pendingUpgradeCategoryId      String?            @map("pending_upgrade_category_id") @db.Uuid
  pendingUpgradeCertCode        String?            @map("pending_upgrade_cert_code") @db.VarChar(10)
  pendingUpgradePromoteToMentor Boolean            @default(false) @map("pending_upgrade_promote_to_mentor")

  member                Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category              MembershipCategory         @relation(fields: [categoryId], references: [id])
  pendingUpgradeCategory MembershipCategory?       @relation("PendingUpgradeCategory", fields: [pendingUpgradeCategoryId], references: [id])
  assignedReviewer      Member?                    @relation("ReviewerAssignments", fields: [assignedReviewerId], references: [id])
  educationRecords      EducationRecord[]
  employmentRecords     EmploymentRecord[]
  studentAssociation    StudentAssociationRecord?
  mentorshipAssignment  MentorshipAssignment?
  firmShareholders      FirmShareholder[]
  uploadedDocuments     UploadedDocument[]
  documentVersions      DocumentVersion[]
  apcAssessments        ApcAssessment[]
  statusHistory         ApplicationStatusHistory[]
  financialTransactions FinancialTransaction[]
  logbookEntries        LogbookEntry[]
  applicationReviews    ApplicationReview[]
  mentorshipReviews     MentorshipReview[]

  @@map("applications")
}

model EducationRecord {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String?   @map("application_id") @db.Uuid
  memberId          String?   @map("member_id") @db.Uuid
  institution       String    @db.VarChar(255)
  qualificationType String    @map("qualification_type") @db.VarChar(100)
  fieldOfStudy      String    @map("field_of_study") @db.VarChar(255)
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime  @map("end_date") @db.Date
  certificateUrl    String?   @map("certificate_url")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  member      Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("education_records")
}

model EmploymentRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String?   @map("application_id") @db.Uuid
  memberId      String?   @map("member_id") @db.Uuid
  companyName   String    @map("company_name") @db.VarChar(255)
  jobTitle      String    @map("job_title") @db.VarChar(100)
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  isCurrent     Boolean   @default(false) @map("is_current")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  member      Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("employment_records")
}

model StudentAssociationRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String    @unique @map("application_id") @db.Uuid
  associationName  String    @map("association_name") @db.VarChar(255)
  membershipNumber String    @map("membership_number") @db.VarChar(100)
  registrationDate DateTime  @map("registration_date") @db.Date
  activeYears      Int       @map("active_years")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("student_association_records")
}

model MentorshipAssignment {
  id                               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId                    String    @unique @map("application_id") @db.Uuid
  mentorName                       String?   @map("mentor_name") @db.VarChar(255)
  mentorQualification              String?   @map("mentor_qualification") @db.VarChar(100)
  mentorClass                      String?   @map("mentor_class") @db.VarChar(100)
  mentorRegistrationNumber         String?   @map("mentor_registration_number") @db.VarChar(100)
  mentorEmployer                   String?   @map("mentor_employer") @db.VarChar(255)
  mentorContact                    String?   @map("mentor_contact") @db.VarChar(255)
  isSelfAssigned                   Boolean?  @default(true) @map("is_self_assigned")
  requestedInstitutionalAssignment Boolean?  @default(false) @map("requested_institutional_assignment")
  preferredMentors                 Json?     @map("preferred_mentors")
  mentorshipPlan                   String?   @map("mentorship_plan")
  preferredPracticeAreas           String[]  @map("preferred_practice_areas")
  completedDurationMonths          Int?      @default(0) @map("completed_duration_months")
  yearOneReportUrl                 String?   @map("year_one_report_url")
  yearTwoReportUrl                 String?   @map("year_two_report_url")
  mentorRecommended                Boolean?  @default(false) @map("mentor_recommended")
  // Retained for backward compatibility with recommendation letters already uploaded.
  mentorRecommendationUrl          String?   @map("mentor_recommendation_url")
  mentorNotes                      String?   @map("mentor_notes") @db.Text
  agreedReviewPeriodStart          DateTime? @map("agreed_review_period_start") @db.Date
  agreedReviewPeriodEnd            DateTime? @map("agreed_review_period_end") @db.Date
  agreedReviewPeriodMonths         Int?      @map("agreed_review_period_months")
  // The Head Reviewer's own final Compliant / Non-compliant conclusion, recorded when
  // forwarding an Associate-route (apcReadiness "Not_Ready") case to the Admin/Approver —
  // distinct from the individual board members' verdicts in MentorshipReview.
  finalComplianceStatus            String?   @map("final_compliance_status") @db.VarChar(20)
  adminNotes                       String?   @map("admin_notes") @db.Text
  upgradeRequested                 Boolean?  @default(false) @map("upgrade_requested")
  apcReadiness                     String?   @default("Unknown") @map("apc_readiness")
  status                           String?   @default("In_Progress") @map("status")
  createdAt                        DateTime? @default(now()) @map("created_at") @db.Timestamptz

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviews     MentorshipReview[]

  @@map("mentorship_assignments")
}

// A separate review record is kept for mentorship upgrades so the original
// membership-application reviews are never reused for an APC decision.
model MentorshipReview {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId          String    @map("application_id") @db.Uuid
  mentorshipAssignmentId String    @map("mentorship_assignment_id") @db.Uuid
  reviewerId             String    @map("reviewer_id") @db.Uuid
  recommendation         String    @default("Recommend") @db.VarChar(50)
  complianceStatus       String?   @map("compliance_status") @db.VarChar(20)
  reviewPeriodStart      DateTime? @map("review_period_start") @db.Date
  reviewPeriodEnd        DateTime? @map("review_period_end") @db.Date
  reviewPeriodMonths     Int?      @map("review_period_months")
  proposedAssessmentDate DateTime? @map("proposed_assessment_date") @db.Timestamptz
  notes                  String?   @db.Text
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  application          Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mentorshipAssignment MentorshipAssignment @relation(fields: [mentorshipAssignmentId], references: [id], onDelete: Cascade)
  reviewer             Member               @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reviewerId])
  @@map("mentorship_reviews")
}

model FirmShareholder {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId          String    @map("application_id") @db.Uuid
  fullName               String    @map("full_name") @db.VarChar(255)
  email                  String    @db.VarChar(255)
  phoneNumber            String    @map("phone_number") @db.VarChar(50)
  citizenship            String?   @default("Rwandan") @db.VarChar(100)
  shareholdingPercentage Decimal   @map("shareholding_percentage") @db.Decimal(5, 2)
  riqsMembershipId       String?   @map("riqs_membership_id") @db.VarChar(100)
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("firm_shareholders")
}

model UploadedDocument {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  documentType  String    @map("document_type") @db.VarChar(100)
  fileName      String    @map("file_name") @db.VarChar(255)
  fileUrl       String    @map("file_url")
  fileSizeBytes Int       @map("file_size_bytes")
  uploadedAt    DateTime? @default(now()) @map("uploaded_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("uploaded_documents")
}

model DocumentVersion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String    @map("application_id") @db.Uuid
  documentType    String    @map("document_type") @db.VarChar(100)
  fileName        String    @map("file_name") @db.VarChar(255)
  fileUrl         String    @map("file_url")
  fileSizeBytes   Int       @map("file_size_bytes")
  versionNumber   Int       @default(1) @map("version_number")
  uploadedByEmail String    @map("uploaded_by_email") @db.VarChar(255)
  uploadedAt      DateTime? @default(now()) @map("uploaded_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

model ApcAssessment {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId                String     @map("member_id") @db.Uuid
  applicationId           String     @map("application_id") @db.Uuid
  assessmentPeriodStart   DateTime?  @map("assessment_period_start") @db.Date
  assessmentPeriodEnd     DateTime?  @map("assessment_period_end") @db.Date
  assessmentDate          DateTime?  @map("assessment_date") @db.Date
  panelChairName  String?    @map("panel_chair_name") @db.VarChar(255)
  panelChairEmail String?    @map("panel_chair_email") @db.VarChar(255)
  examiner1Name   String?    @map("examiner_1_name") @db.VarChar(255)
  examiner1Email  String?    @map("examiner_1_email") @db.VarChar(255)
  examiner2Name   String?    @map("examiner_2_name") @db.VarChar(255)
  examiner2Email  String?    @map("examiner_2_email") @db.VarChar(255)
  status          ApcStatus? @default(Scheduled)
  scorePercentage Decimal?   @map("score_percentage") @db.Decimal(5, 2)
  assessmentNotes String?    @map("assessment_notes")
  stampFeePaid    Boolean?   @default(false) @map("stamp_fee_paid")
  licenseIssued   Boolean?   @default(false) @map("license_issued")
  createdAt       DateTime?  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?  @default(now()) @map("updated_at") @db.Timestamptz

  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("apc_assessments")
}

model ApplicationStatusHistory {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId  String             @map("application_id") @db.Uuid
  changedByEmail String             @map("changed_by_email") @db.VarChar(255)
  oldStatus      ApplicationStatus? @map("old_status")
  newStatus      ApplicationStatus  @map("new_status")
  reviewerNotes  String?            @map("reviewer_notes")
  createdAt      DateTime?          @default(now()) @map("created_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model ApplicationReview {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  reviewerId    String    @map("reviewer_id") @db.Uuid
  reviewRound   Int       @default(1) @map("review_round")
  complianceStatus String? @map("compliance_status") @db.VarChar(20)
  notes         String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    Member      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reviewerId, reviewRound])
  @@map("application_reviews")
}

model FinancialTransaction {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId             String             @map("member_id") @db.Uuid
  applicationId        String?            @map("application_id") @db.Uuid
  amount               Decimal            @db.Decimal(12, 2)
  currency             String             @db.VarChar(3)
  txType               TransactionType    @map("tx_type")
  paymentMethod        PaymentMethod      @map("payment_method")
  transactionReference String             @unique @map("transaction_reference") @db.VarChar(255)
  providerTransactionId String?           @unique @map("provider_transaction_id") @db.VarChar(100)
  status               TransactionStatus? @default(Pending_Verification)
  verifiedByEmail      String?            @map("verified_by_email") @db.VarChar(255)
  rejectionReason      String?            @map("rejection_reason")
  invoiceUrl           String?            @map("invoice_url")
  receiptUrl           String?            @map("receipt_url")
  cpdDocumentUrl       String?            @map("cpd_document_url")
  clearedAt            DateTime?          @map("cleared_at") @db.Timestamptz
  createdAt            DateTime?          @default(now()) @map("created_at") @db.Timestamptz

  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@map("financial_transactions")
}

model AuditLog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId      String?   @map("member_id") @db.Uuid
  actionByEmail String    @map("action_by_email") @db.VarChar(255)
  actionType    String    @map("action_type") @db.VarChar(100)
  details       String?
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model EmailTemplate {
  id          String    @id @db.VarChar(100)
  name        String    @db.VarChar(255)
  category    String    @db.VarChar(100)
  subject     String    @db.VarChar(255)
  description String?   @db.Text
  body        String    @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("email_templates")
}

model DocumentType {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique @db.VarChar(255)
  code           String   @unique @db.VarChar(100)
  appliesTo      String   @default("Both") @map("applies_to") @db.VarChar(50)
  isPaymentProof Boolean  @default(false) @map("is_payment_proof")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("document_types")
}

model LogbookEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  period        String   @db.VarChar(100) // e.g., "Month 1-6"
  documentUrl   String   @map("document_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("logbook_entries")
}

model SupportTicket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  subject   String   @db.VarChar(255)
  category  String   @db.VarChar(100)
  status    String   @default("Open") @db.VarChar(50)
  priority  String   @default("Medium") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  member  Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender Member        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}
