PORT=5000
API_PORT=5000
# Self-hosted Postgres (see database/ at the repo root). Both point at the same connection —
# no pgbouncer pooler here, unlike the old Supabase setup, so there's no functional
# difference between them anymore; DIRECT_URL is kept only because schema.prisma's
# datasource still references it for migration commands.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=

# Dev convenience only — see authController.ts's isTestEmailBypass. Leave unset/false in
# production. When true, a fixed list of test accounts gets a predictable OTP (123456) and
# skips real email delivery.
ENABLE_TEST_EMAIL_BYPASS=false

# Self-hosted object storage (see storage/ at the repo root). host.docker.internal is the
# backend container's route to the host machine's 127.0.0.1-bound MinIO — see
# backend/docker-compose.yml's extra_hosts entry.
MINIO_ENDPOINT=host.docker.internal
MINIO_API_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=riqs-membership
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
SMTP_HOST=mail.rwandaiqs.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply-riqs@rwandaiqs.org
SMTP_PASSWORD=
SMTP_FROM="RIQS Registry <noreply-riqs@rwandaiqs.org>"
INTOUCHPAY_BASE_URL=https://developer.intouchpay.co.rw/api/v1/sandbox
INTOUCH_USERNAME=
INTOUCH_ACCOUNT_NO=
INTOUCH_PARTNER_PASSWORD=
INTOUCH_CALLBACK_URL=
INTOUCH_SID=1
