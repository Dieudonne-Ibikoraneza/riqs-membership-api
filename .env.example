PORT=5000
API_PORT=5000
DATABASE_URL=postgresql://riqs:<POSTGRES_PASSWORD>@riqs-postgres:5432/riqs
DIRECT_URL=postgresql://riqs:<POSTGRES_PASSWORD>@riqs-postgres:5432/riqs
JWT_SECRET=

ENABLE_TEST_EMAIL_BYPASS=false

MINIO_ENDPOINT=riqs-minio
MINIO_API_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=riqs-membership
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
SMTP_HOST=mail.rwandaiqs.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply-riqs@rwandaiqs.org
SMTP_PASSWORD=
SMTP_FROM="RIQS Registry <noreply-riqs@rwandaiqs.org>"
# UrubutoPay merchant API
URUBUTOPAY_BASE_URL=https://<urubutopay-sandbox-or-production-host>
URUBUTOPAY_API_KEY=upg:<merchant-api-key>
URUBUTOPAY_MERCHANT_CODE=
URUBUTOPAY_SERVICE_CODE=

# UrubutoPay calls these credentials to obtain a JWT before sending callbacks.
URUBUTOPAY_WEBHOOK_USERNAME=
URUBUTOPAY_WEBHOOK_PASSWORD=
URUBUTOPAY_WEBHOOK_JWT_SECRET=
URUBUTOPAY_DEFAULT_PAYER_EMAIL=payments@riqs.org.rw
