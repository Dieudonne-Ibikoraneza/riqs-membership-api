PORT=5000
API_PORT=5000
DATABASE_URL=postgresql://riqs:<POSTGRES_PASSWORD>@riqs-postgres:5432/riqs
DIRECT_URL=postgresql://riqs:<POSTGRES_PASSWORD>@riqs-postgres:5432/riqs
JWT_SECRET=

ENABLE_TEST_EMAIL_BYPASS=false

MINIO_ENDPOINT=riqs-minio
MINIO_API_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=riqs-membership
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
SMTP_HOST=mail.rwandaiqs.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply-riqs@rwandaiqs.org
SMTP_PASSWORD=
SMTP_FROM="RIQS Registry <noreply-riqs@rwandaiqs.org>"
# UrubutoPay merchant API
# Staging gateway tested at https://staging.urubutopay.rw/api.
# Do not append /v2; the adapter adds versioned paths.
URUBUTOPAY_BASE_URL=https://staging.urubutopay.rw/api
# testing uses x-api-key; live uses Authorization. If omitted, infer from the base URL.
URUBUTOPAY_ENVIRONMENT=testing
# Sent with the upg: prefix in the environment's selected header.
URUBUTOPAY_API_KEY=upg:<api-key-from-BK>
URUBUTOPAY_MERCHANT_CODE=
URUBUTOPAY_SERVICE_CODE=
# Optional: required only when your merchant has multiple wallets.
URUBUTOPAY_WALLET_ACCOUNT_ID=

# UrubutoPay calls these credentials to obtain a JWT before sending callbacks.
URUBUTOPAY_WEBHOOK_USERNAME=
URUBUTOPAY_WEBHOOK_PASSWORD=
URUBUTOPAY_WEBHOOK_JWT_SECRET=
URUBUTOPAY_DEFAULT_PAYER_EMAIL=payments@riqs.org.rw
